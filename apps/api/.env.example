# Copy to `.env.development` (local) or `.env.production`, then fill in the
# values. These files are git-ignored: never commit real credentials.
# On a hosting platform, set the same names as config vars instead.

NODE_ENV=development
HOST=localhost
PORT=3000
PRODUCTION_URL=

# Front-end origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:4200

# MongoDB connection string
DB_URI=mongodb://127.0.0.1:27017/portal

# Auth: use a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90
API_KEY_THIRD_PARTY=

# Email (SMTP in development, SendGrid in production)
EMAIL_FROM=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASS=
USE_SENDGRID=false
SENDGRID_USERNAME=apikey
SENDGRID_PASSWORD=

# File uploads
UPLOAD_TARGET=local
AWS_REGION=eu-north-1
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI assistant (optional): without it the assistant endpoint returns 503
GROQ_API_KEY=
