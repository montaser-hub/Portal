# Copy to `.env`. Both have local defaults, so this file is optional in development.

# Base URL of the API, e.g. https://api.example.com/api/v1
VITE_POTRAL_API_URL=http://localhost:3000/api/v1

# The Angular admin portal that the "Setting" link opens for admins and managers
VITE_ADMIN_PORTAL_URL=http://localhost:4200
